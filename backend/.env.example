APP_ENV=development
APP_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://easyearn:easyearn_dev_password@localhost:5432/easyearn
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
MAX_REQUEST_BODY_BYTES=20480
SESSION_COOKIE_NAME=easyearn_session
SESSION_TTL_SECONDS=604800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
# This default URL is the local Compose bootstrap administrator, not a production API role.
# After explicit role provisioning, use the easyearn_api login here.
# Use separate .env.worker and .env.migrations environments for those processes.

# Shared authentication limits. All workers must use the same Redis and key prefix.
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.5
REDIS_MAX_CONNECTIONS=20
AUTH_RATE_LIMIT_KEY_PREFIX=easyearn:auth-limits
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_SIGNUP=5
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_VERIFICATION_REQUEST=5
AUTH_RATE_LIMIT_VERIFICATION_CONFIRM=20
AUTH_RATE_LIMIT_PASSWORD_FORGOT=5
AUTH_RATE_LIMIT_PASSWORD_RESET=10

# Account email tokens: verification 24 hours; reset 30 minutes; resend cooldown 60 seconds.
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_COOLDOWN_SECONDS=60

# Local Mailpit; no domain or provider account required.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_TIMEOUT_SECONDS=10
# Production: use a managed SMTP service, TLS, and your verified sender address.
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# REQUIRED before API/worker startup. Generate a fresh key ring with:
# uv run python -m app.workers.email --generate-key
# Paste the printed JSON array here; keep the same ring in API and worker environments.
EMAIL_OUTBOX_KEYS=[]
EMAIL_WORKER_POLL_SECONDS=1
EMAIL_WORKER_LEASE_SECONDS=120
EMAIL_WORKER_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_CLEANUP_INTERVAL_SECONDS=300
EMAIL_CLEANUP_BATCH_SIZE=500
EMAIL_OUTBOX_RETENTION_SECONDS=604800
