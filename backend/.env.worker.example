EASYEARN_ENV_FILE=.env.worker
APP_ENV=development
APP_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://easyearn_worker:replace-with-generated-secret@localhost:5432/easyearn
# Copy the same key ring as the API, but never its database credentials.
EMAIL_OUTBOX_KEYS=[]
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_FROM_EMAIL=no-reply@example.com
